# Haifa Personal Assistant 运行环境变量（Windows 便携包）
# 由 bin/start.bat 读取；格式与 Linux 包的 conf/pa.env 完全一致。
# 已存在的系统环境变量优先，此文件只提供缺省值。

# 数据目录：SQLite、图片/音频、任务产物都在这里
HAIFA_PERSONAL_DATA_DIR=./data/personal-assistant

# Host Guarded 执行开关：服务在 false 时会拒绝启动（fail closed）
HAIFA_PERSONAL_EXECUTION_TRUSTED_HOST_ENABLED=true

# Codex 客户端标识（使用 openai-codex 绑定时需要）
HAIFA_CODEX_ORIGINATOR=haifa
HAIFA_CODEX_USER_AGENT=haifa-agent/1
