{
  "openapi": "3.1.0",
  "info": {
    "title": "Haifa Personal Assistant API",
    "version": "1.0.0",
    "description": "Loopback-only Phase 21 Personal Assistant HTTP and WebFlux SSE contract."
  },
  "servers": [{"url": "http://127.0.0.1:20001"}],
  "paths": {
    "/api/v1/bootstrap": {
      "get": {"operationId": "bootstrap", "responses": {"200": {"description": "Product bootstrap"}}}
    },
    "/api/v1/conversations": {
      "get": {"operationId": "listConversations", "responses": {"200": {"description": "Conversations"}}},
      "post": {
        "operationId": "createConversation",
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}],
        "responses": {"201": {"description": "Created"}, "400": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/api/v1/conversations/{conversationId}": {
      "parameters": [{"$ref": "#/components/parameters/ConversationId"}],
      "get": {"operationId": "getConversation", "responses": {"200": {"description": "Conversation"}, "404": {"$ref": "#/components/responses/Error"}}},
      "patch": {
        "operationId": "updateConversation",
        "parameters": [{"$ref": "#/components/parameters/IfMatch"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "responses": {"200": {"description": "Updated"}, "409": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/api/v1/conversations/{conversationId}/turns": {
      "get": {
        "operationId": "listTurns",
        "parameters": [{"$ref": "#/components/parameters/ConversationId"}],
        "responses": {"200": {"description": "Turns"}}
      }
    },
    "/api/v1/conversations/{conversationId}/messages": {
      "post": {
        "operationId": "submitMessage",
        "parameters": [
          {"$ref": "#/components/parameters/ConversationId"},
          {"$ref": "#/components/parameters/IfMatch"},
          {"$ref": "#/components/parameters/IdempotencyKey"}
        ],
        "responses": {"202": {"description": "Run accepted"}, "409": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/api/v1/runs/{runId}": {
      "get": {
        "operationId": "getRun",
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "responses": {"200": {"description": "Run and authoritative usage"}, "404": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/api/v1/runs/{runId}/cancel": {
      "post": {
        "operationId": "cancelRun",
        "parameters": [{"$ref": "#/components/parameters/RunId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "responses": {"200": {"description": "Cancelled"}}
      }
    },
    "/api/v1/runs/{runId}/activities": {
      "get": {
        "operationId": "listSafeActivities",
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "responses": {"200": {"description": "Bounded Tool, Skill, and MCP activity projection"}}
      }
    },
    "/api/v1/runs/{runId}/interaction": {
      "get": {
        "operationId": "getPendingInteraction",
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "responses": {"200": {"description": "Pending interaction"}, "204": {"description": "No pending interaction"}}
      }
    },
    "/api/v1/runs/{runId}/interactions/{interactionId}/response": {
      "post": {
        "operationId": "respondToInteraction",
        "parameters": [
          {"$ref": "#/components/parameters/RunId"},
          {"name": "interactionId", "in": "path", "required": true, "schema": {"type": "string"}},
          {"$ref": "#/components/parameters/IfMatch"},
          {"$ref": "#/components/parameters/IdempotencyKey"}
        ],
        "responses": {"200": {"description": "Response receipt"}, "409": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/api/v1/runs/{runId}/stream": {
      "get": {
        "operationId": "streamRun",
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "responses": {
          "200": {
            "description": "WebFlux Server-Sent Events",
            "content": {"text/event-stream": {"schema": {"type": "string"}}}
          }
        }
      }
    },
    "/api/v1/memory/candidates": {
      "get": {"operationId": "listMemoryCandidates", "responses": {"200": {"description": "Pending candidates"}}}
    },
    "/api/v1/memory/candidates/{candidateId}/approve": {
      "post": {
        "operationId": "approveMemoryCandidate",
        "parameters": [
          {"name": "candidateId", "in": "path", "required": true, "schema": {"type": "string"}},
          {"$ref": "#/components/parameters/IfMatch"},
          {"$ref": "#/components/parameters/IdempotencyKey"}
        ],
        "responses": {"200": {"description": "Approved memory"}}
      }
    },
    "/api/v1/memory/candidates/{candidateId}/reject": {
      "post": {
        "operationId": "rejectMemoryCandidate",
        "parameters": [
          {"name": "candidateId", "in": "path", "required": true, "schema": {"type": "string"}},
          {"$ref": "#/components/parameters/IfMatch"},
          {"$ref": "#/components/parameters/IdempotencyKey"}
        ],
        "responses": {"200": {"description": "Rejected candidate"}}
      }
    },
    "/api/v1/memory": {
      "get": {"operationId": "listMemories", "responses": {"200": {"description": "Memories"}}}
    },
    "/api/v1/memory/{memoryId}/versions/{version}/invalidate": {
      "post": {
        "operationId": "invalidateMemory",
        "parameters": [
          {"name": "memoryId", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "version", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}},
          {"$ref": "#/components/parameters/IdempotencyKey"}
        ],
        "responses": {"200": {"description": "Invalidated memory"}}
      }
    }
  },
  "components": {
    "parameters": {
      "ConversationId": {"name": "conversationId", "in": "path", "required": true, "schema": {"type": "string"}},
      "RunId": {"name": "runId", "in": "path", "required": true, "schema": {"type": "string"}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "maxLength": 128}},
      "IfMatch": {"name": "If-Match", "in": "header", "required": true, "schema": {"type": "string"}}
    },
    "responses": {
      "Error": {
        "description": "Stable safe error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["code", "message", "correlationId"],
              "properties": {
                "code": {"type": "string"},
                "message": {"type": "string"},
                "correlationId": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
