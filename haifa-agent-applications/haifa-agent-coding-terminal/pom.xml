<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.haifa</groupId>
        <artifactId>haifa-agent-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>haifa-agent-coding-terminal</artifactId>
    <name>Haifa Coding Terminal</name>

    <dependencies>
        <dependency>
            <groupId>io.haifa</groupId>
            <artifactId>haifa-agent-coding-agent</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.haifa</groupId>
                    <artifactId>haifa-agent-runtime-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.haifa</groupId>
                    <artifactId>haifa-agent-store-sqlite</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency><groupId>io.haifa</groupId><artifactId>haifa-agent-common</artifactId></dependency>
        <dependency><groupId>io.haifa</groupId><artifactId>haifa-agent-core</artifactId></dependency>
        <dependency><groupId>io.haifa</groupId><artifactId>haifa-agent-runtime-api</artifactId></dependency>
        <dependency><groupId>com.williamcallahan</groupId><artifactId>tui4j</artifactId></dependency>

        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>coding-terminal-stays-on-stable-boundaries</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>io.haifa:haifa-agent-runtime-core</exclude>
                                        <exclude>io.haifa:haifa-agent-store-sqlite</exclude>
                                        <exclude>io.haifa:haifa-agent-sandbox-*</exclude>
                                        <exclude>io.haifa:haifa-agent-testing</exclude>
                                        <exclude>org.jline:jline-builtins</exclude>
                                        <exclude>org.jline:jline-console-ui</exclude>
                                    </excludes>
                                    <searchTransitive>false</searchTransitive>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>coding-terminal-has-no-legacy-jline-dependencies</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.jline:jline-reader</exclude>
                                        <exclude>org.jline:jline-style</exclude>
                                        <exclude>org.jline:jline-builtins</exclude>
                                        <exclude>org.jline:jline-console-ui</exclude>
                                    </excludes>
                                    <searchTransitive>true</searchTransitive>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
