{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pa.research-delivery/v2",
  "type": "object",
  "required": [
    "schemaVersion", "completionKind", "degraded", "degradationReasons",
    "reportArtifactRef", "sourcesArtifactRef", "claimEvidenceArtifactRef", "unresolvedArtifactRef",
    "coveredTaskIds", "affectedTaskIds", "sourceCount", "unverifiedClaimCount",
    "unresolvedQuestionCount", "evidenceSummary", "efficiencyMetrics", "qualityGate"
  ],
  "properties": {
    "schemaVersion": { "const": "pa.research-delivery/v2" },
    "completionKind": { "enum": ["COMPLETE", "PARTIAL"] },
    "degraded": { "type": "boolean" },
    "degradationReasons": { "type": "array", "maxItems": 20, "items": { "type": "string" } },
    "reportArtifactRef": { "$ref": "#/$defs/artifactRef" },
    "sourcesArtifactRef": { "$ref": "#/$defs/artifactRef" },
    "claimEvidenceArtifactRef": { "$ref": "#/$defs/artifactRef" },
    "unresolvedArtifactRef": { "$ref": "#/$defs/artifactRef" },
    "coveredTaskIds": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
    "affectedTaskIds": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
    "sourceCount": { "type": "integer", "minimum": 0, "maximum": 24 },
    "unverifiedClaimCount": { "type": "integer", "minimum": 0, "maximum": 320 },
    "unresolvedQuestionCount": { "type": "integer", "minimum": 0, "maximum": 160 },
    "evidenceSummary": {
      "type": "object",
      "required": [
        "totalClaimCount", "unverifiedClaimCount", "singleSourceClaimCount",
        "counterevidenceClaimCount", "unresolvedQuestionCount"
      ],
      "additionalProperties": false,
      "properties": {
        "totalClaimCount": { "type": "integer", "minimum": 0, "maximum": 320 },
        "unverifiedClaimCount": { "type": "integer", "minimum": 0, "maximum": 320 },
        "singleSourceClaimCount": { "type": "integer", "minimum": 0, "maximum": 320 },
        "counterevidenceClaimCount": { "type": "integer", "minimum": 0, "maximum": 320 },
        "unresolvedQuestionCount": { "type": "integer", "minimum": 0, "maximum": 160 }
      }
    },
    "efficiencyMetrics": {
      "type": "object",
      "required": [
        "tokensPerValidSource", "duplicateSearchFetchRatio", "evidencePerMaterialClaim",
        "singleSourceClaimRatio", "synthesisTokenRatio", "qualityGateRevisionCount"
      ],
      "additionalProperties": false,
      "properties": {
        "tokensPerValidSource": { "type": "number", "minimum": 0 },
        "duplicateSearchFetchRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidencePerMaterialClaim": { "type": "number", "minimum": 0 },
        "singleSourceClaimRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "synthesisTokenRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "qualityGateRevisionCount": { "type": "integer", "minimum": 0, "maximum": 2 }
      }
    },
    "qualityGate": {
      "type": "object",
      "required": ["passed", "failedChecks"],
      "additionalProperties": false,
      "properties": {
        "passed": { "type": "boolean" },
        "failedChecks": { "type": "array", "maxItems": 20, "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "required": ["artifactId", "version", "sha256", "byteCount", "mediaType", "title"],
      "additionalProperties": false,
      "properties": {
        "artifactId": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "byteCount": { "type": "integer", "minimum": 1 },
        "mediaType": { "type": "string" },
        "title": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "degraded": { "const": true } }, "required": ["degraded"] },
      "then": { "properties": { "completionKind": { "const": "PARTIAL" } } }
    }
  ],
  "additionalProperties": false
}
