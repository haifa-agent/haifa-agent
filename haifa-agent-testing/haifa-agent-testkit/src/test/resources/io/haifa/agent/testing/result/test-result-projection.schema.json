{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haifa.agent/schemas/testing/test-result-projection.schema.json",
  "title": "Haifa Agent Cross-Suite Test Result Projection Batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectionType",
    "suiteSystem",
    "suiteId",
    "generatedAt",
    "results"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectionType": { "const": "CROSS_SUITE_RESULT_V1" },
    "suiteSystem": { "enum": ["CRITICAL_PATH", "AUTONOMOUS_DELIVERY"] },
    "suiteId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "results": {
      "type": "array",
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "suiteSystem",
        "suiteId",
        "caseId",
        "caseVersion",
        "repetition",
        "scope",
        "dependencyMode",
        "productEntry",
        "platform",
        "matrixCombination",
        "productCommit",
        "testConfigCommit",
        "status",
        "nativeStatus",
        "startedAt",
        "durationMillis",
        "providerUsage",
        "evidenceRef",
        "failureCategory"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "suiteSystem": { "enum": ["CRITICAL_PATH", "AUTONOMOUS_DELIVERY"] },
        "suiteId": { "type": "string", "minLength": 1 },
        "caseId": { "type": "string", "minLength": 1 },
        "caseVersion": { "type": "string", "minLength": 1 },
        "repetition": { "type": "integer", "minimum": 1 },
        "scope": {
          "enum": ["UNIT", "COMPONENT", "CONTRACT", "INTEGRATION", "LIVE", "E2E", "EVALUATION", "ARCHITECTURE"]
        },
        "dependencyMode": {
          "enum": ["DETERMINISTIC", "CONTROLLED", "LOCAL_REAL", "STUB", "LIVE"]
        },
        "productEntry": { "type": "string", "minLength": 1 },
        "platform": { "enum": ["linux", "macos", "windows"] },
        "matrixCombination": { "type": "string", "minLength": 1 },
        "productCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "testConfigCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "status": {
          "enum": ["PASS", "FAIL", "BLOCKED_ENVIRONMENT", "NOT_RUN", "PLAN_ONLY", "SKIPPED"]
        },
        "nativeStatus": { "type": "string", "minLength": 1 },
        "startedAt": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "durationMillis": { "type": "integer", "minimum": 0 },
        "providerUsage": {
          "type": "object",
          "required": ["costKnown"],
          "properties": {
            "modelCalls": { "type": "integer", "minimum": 0 },
            "toolCalls": { "type": "integer", "minimum": 0 },
            "toolFailures": { "type": "integer", "minimum": 0 },
            "inputTokens": { "type": "integer", "minimum": 0 },
            "outputTokens": { "type": "integer", "minimum": 0 },
            "costKnown": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "failureCategory": { "type": "string", "minLength": 1 }
      }
    }
  }
}
