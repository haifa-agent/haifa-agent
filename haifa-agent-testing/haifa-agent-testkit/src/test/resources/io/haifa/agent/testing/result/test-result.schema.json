{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haifa.agent/schemas/testing/test-result.schema.json",
  "title": "Haifa Agent Functional Test Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "caseId",
    "caseVersion",
    "variantId",
    "attempt",
    "status",
    "startedAt",
    "durationMs",
    "build",
    "environment",
    "executionMode",
    "codeMapping"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "runId": { "type": "string", "minLength": 5 },
    "caseId": { "type": "string", "pattern": "^HF-(03|04|05|06)-(FUNC|COMB|E2E|CROSS|REC|SEC|ARCH)-[A-Z0-9-]+-[0-9]{3}$" },
    "caseVersion": { "type": "integer", "minimum": 1 },
    "variantId": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["PASSED", "FAILED", "ERROR", "SKIPPED", "NOT_RUN", "TIMEOUT", "BLOCKED", "NOT_APPLICABLE"] },
    "executionMode": { "enum": ["LOCAL", "STUB", "LIVE"] },
    "classification": { "enum": ["PRODUCT_DEFECT", "TEST_DEFECT", "ENVIRONMENT_DEFECT", "REQUIREMENT_QUESTION", "KNOWN_LIMITATION", "FLAKY", "NONE"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "integer", "minimum": 0 },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "version"],
      "properties": {
        "commit": { "type": "string", "minLength": 7 },
        "version": { "type": "string", "minLength": 1 },
        "branch": { "type": "string" },
        "dirty": { "type": "boolean" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environmentId", "os", "javaVersion", "mavenVersion"],
      "properties": {
        "environmentId": { "type": "string" },
        "os": { "enum": ["WINDOWS", "LINUX", "MACOS"] },
        "javaVersion": { "type": "string" },
        "mavenVersion": { "type": "string" },
        "profile": { "type": "string" }
      }
    },
    "externalDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dependencyId", "endpointSummary", "version", "evidenceRef"],
        "properties": {
          "dependencyId": { "type": "string", "pattern": "^EXT-[A-Z0-9-]+$" },
          "endpointSummary": { "type": "string" },
          "version": { "type": "string" },
          "evidenceRef": { "type": "string" },
          "callCount": { "type": "integer", "minimum": 0 },
          "inputTokens": { "type": "integer", "minimum": 0 },
          "outputTokens": { "type": "integer", "minimum": 0 },
          "estimatedCost": { "type": "number", "minimum": 0 }
        }
      }
    },
    "filesystemSafety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policyId": { "type": "string" },
        "sentinelHash": { "type": "string" },
        "ownedPathCount": { "type": "integer", "minimum": 0 },
        "outsideSentinelUnchanged": { "type": "boolean" },
        "cleanupState": { "enum": ["NOT_REQUIRED", "RELEASED", "QUARANTINED", "PURGED", "RETAINED_FOR_INVESTIGATION"] }
      }
    },
    "codeMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "className", "methodName"],
      "properties": {
        "module": { "type": "string" },
        "sourceFile": { "type": "string" },
        "className": { "type": "string" },
        "methodName": { "type": "string" }
      }
    },
    "actualResult": { "type": "string" },
    "errorType": { "type": "string" },
    "errorMessage": { "type": "string" },
    "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "defectIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "firstAttemptStatus": { "enum": ["PASSED", "FAILED", "ERROR", "SKIPPED", "NOT_RUN", "TIMEOUT", "BLOCKED", "NOT_APPLICABLE"] },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "executionMode": { "const": "LIVE" } } },
      "then": {
        "required": ["externalDependencies"],
        "properties": { "externalDependencies": { "minItems": 1 } }
      }
    }
  ]
}
