{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haifa.io/testing/autonomous-delivery/acceptance-result.schema.json",
  "title": "Autonomous Delivery Acceptance Result",
  "description": "Accepts the capability-ladder result (caseId Lx-yy with status, emitted by haifa-agent-autonomous-delivery) and the frozen legacy result of the historical cases (case or no identifier). The two shapes are mutually exclusive.",
  "oneOf": [
    { "$ref": "#/$defs/ladderResult" },
    { "$ref": "#/$defs/legacyResult" }
  ],
  "$defs": {
    "checks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "boolean" }
    },
    "failures": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "maxLength": 512 }
    },
    "caseVersion": {
      "type": "string",
      "minLength": 1
    },
    "ladderResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "caseId", "caseVersion", "status", "passed", "checks", "failures"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "caseId": { "type": "string", "pattern": "^L[1-6]-0[1-9]$" },
        "caseVersion": { "$ref": "#/$defs/caseVersion" },
        "status": { "enum": ["PASSED", "FAILED", "INCOMPLETE_BUDGET"] },
        "passed": { "type": "boolean" },
        "checks": { "$ref": "#/$defs/checks" },
        "failures": { "$ref": "#/$defs/failures" },
        "durationMillis": { "type": "integer", "minimum": 0 }
      }
    },
    "legacyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "checks", "failures"],
      "properties": {
        "case": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$" },
        "passed": { "type": "boolean" },
        "checks": { "$ref": "#/$defs/checks" },
        "failures": { "$ref": "#/$defs/failures" }
      }
    }
  }
}