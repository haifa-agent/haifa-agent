{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haifa.io/testing/autonomous-delivery/run-result.schema.json",
  "title": "Autonomous Delivery Run Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "caseVersion",
    "repeat",
    "termination",
    "successful",
    "hiddenAcceptance",
    "usage",
    "evidence"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "type": "string", "pattern": "^(0[1-9]|10)$" },
    "caseVersion": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
    "repeat": { "type": "integer", "minimum": 1 },
    "termination": { "type": "string", "minLength": 1, "maxLength": 128 },
    "successful": { "type": "boolean" },
    "hiddenAcceptance": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] },
    "usage": { "$ref": "#/$defs/usage" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceChanged", "validationAttempted", "diffInspected"],
      "properties": {
        "workspaceChanged": { "type": "boolean" },
        "validationAttempted": { "type": "boolean" },
        "diffInspected": { "type": "boolean" },
        "failureAtomicity": { "enum": ["PASS", "FAIL", "NOT_APPLICABLE", "NOT_RUN"] }
      }
    }
  },
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelCalls",
        "toolCalls",
        "toolFailures",
        "inputTokens",
        "outputTokens",
        "wallTimeMillis",
        "costKnown"
      ],
      "properties": {
        "modelCalls": { "type": "integer", "minimum": 0 },
        "toolCalls": { "type": "integer", "minimum": 0 },
        "toolFailures": { "type": "integer", "minimum": 0 },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "wallTimeMillis": { "type": "integer", "minimum": 0 },
        "costKnown": { "type": "boolean" },
        "costUsd": { "type": "number", "minimum": 0 }
      }
    }
  }
}
