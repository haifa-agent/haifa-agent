{
  "schemaVersion": "1.1.0",
  "source": "SYNTHETIC_FROM_AGGREGATE_SHAPES",
  "privacy": {
    "containsCredentials": false,
    "containsHostPaths": false,
    "containsPrompts": false,
    "containsProviderResponses": false,
    "containsRealRepositoryData": false
  },
  "baseline": {
    "sessions": 1,
    "runs": 15,
    "toolCalls": 130,
    "failedToolCalls": 24,
    "normalNonzeroExitFacts": 2
  },
  "cases": [
    {
      "caseId": "diff-normal-exit",
      "syntheticCommand": "git diff --no-index left.txt right.txt",
      "observation": {"processState": "EXITED", "exitCode": 1},
      "expected": {"toolCompleted": true, "rawExitCode": 1, "businessOutcomeInferred": false}
    },
    {
      "caseId": "missing-revision",
      "syntheticCommand": "git show missing-revision",
      "observation": {"processState": "EXITED", "exitCode": 128},
      "expected": {"toolCompleted": true, "rawExitCode": 128, "businessOutcomeInferred": false}
    },
    {
      "caseId": "sensitive-path-write",
      "observation": {"toolName": "file_patch", "stableFailureCode": "SENSITIVE_PATH"},
      "expected": {"toolFailure": true, "recoveryAction": "USER_ACTION_REQUIRED"}
    },
    {
      "caseId": "stale-file-cursor",
      "observation": {"toolName": "file_read", "stableFailureCode": "FILE_CURSOR_STALE"},
      "expected": {"toolFailure": true, "recoveryAction": "RESTART_READ_FROM_CURRENT_VERSION", "maximumRetries": 1}
    },
    {
      "caseId": "write-missing-target",
      "observation": {"toolName": "file_write", "stableFailureCode": "TARGET_MISSING"},
      "expected": {"toolFailure": true, "recoveryAction": "USE_FILE_CREATE"}
    },
    {
      "caseId": "empty-model-output",
      "observation": {"runFailureCode": "MODEL_RESPONSE_INVALID", "sideEffectDispatched": false},
      "expected": {"boundedRetry": true, "maximumRetries": 2}
    },
    {
      "caseId": "context-preflight",
      "observation": {"runFailureCode": "MODEL_CONTEXT_TOO_LONG"},
      "expected": {"preflightCompaction": true, "reserveDeliveryContext": true}
    },
    {
      "caseId": "plural-change-sets",
      "observation": {"changeSetIds": ["change-a", "change-b"], "repeatedDecision": true},
      "expected": {"meaningfulProgress": true, "uniqueChangeSetEvidence": 2}
    },
    {
      "caseId": "push-outcome-unknown",
      "syntheticCommand": "git push origin feature",
      "observation": {"dispatchStarted": true, "processState": "UNKNOWN"},
      "expected": {"automaticReplay": false, "recoveryAction": "VERIFY_REMOTE_FACTS"}
    }
  ]
}
