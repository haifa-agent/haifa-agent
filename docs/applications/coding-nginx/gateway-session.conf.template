auth_request /__haifa_gateway;
error_page 401 = @haifa_gateway_required;

location = /__haifa_gateway {
    internal;
    auth_request off;
    proxy_pass http://127.0.0.1:{{AUTH_PORT}}/verify;
    proxy_pass_request_body off;
    proxy_pass_request_headers off;
    proxy_set_header Content-Length "";
    proxy_set_header Cookie $http_cookie;
}

location @haifa_gateway_required {
    auth_request off;
    add_header X-Haifa-Gateway-Session required always;
    add_header Cache-Control no-store always;
    return 401;
}
